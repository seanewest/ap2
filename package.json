{
  "name": "after-party",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "node dist-api/index.js",
    "build:api": "vite build --config vite.api.config.ts",
    "calling-bot": "node dist-calling-bot/index.js",
    "build:calling-bot": "tsc -p tsconfig.calling-bot.json",
    "check:artifact-hygiene": "node scripts/check-repository-artifact-hygiene.ts",
    "check:api-container-provenance": "node scripts/api-container-provenance.ts",
    "update:api-container-base": "node scripts/update-api-container-base.ts",
    "windows-update-baseline": "node scripts/windows-update-baseline.mjs",
    "global-secure-access-baseline": "node scripts/global-secure-access-baseline.mjs",
    "rachel-retained-avd": "node scripts/rachel-retained-avd-execution.mjs",
    "windows-hello-passkeys": "node scripts/windows-hello-passkey-profile.mjs",
    "test:microsoft365dsc-baseline": "vitest run scripts/microsoft365dsc-baseline.test.mjs",
    "check:workflow-security": "node scripts/check-github-actions-security.ts",
    "check:windows-host-boundary": "node scripts/check-windows-host-boundary.ts",
    "check:durable-runtime": "sh scripts/run-ap2-durable-readiness.sh",
    "check:student-desired-state": "node scripts/student-tenant-desired-state.mjs inspect",
    "development-vault": "node scripts/development-key-vault.mjs",
    "check:spa-bundle": "node scripts/check-spa-bundle-budget.ts",
    "check:api-routes": "node scripts/check-api-route-contracts.ts",
    "check:api-replicas": "node scripts/api-single-replica-contract.ts scripts/fixtures/api-single-replica-plan.json",
    "compile:api-deployment-artifact": "node scripts/api-container-app-deployment-artifact.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:spa-bundle && node scripts/build-docs.ts && npm run build:api && npm run build:calling-bot",
    "check:rehearsal-status": "node scripts/check-rehearsal-status.ts",
    "check:shared-device-readiness": "node scripts/shared-device-provisioning-readiness.ts",
    "preview:calendar-reset": "node scripts/preview-calendar-reset.ts",
    "preview:oauth-app-recon": "node scripts/preview-oauth-app-recon.ts",
    "observe:oauth-recon-signin": "node scripts/observe-oauth-recon-signin.ts",
    "observe:defender-endpoint-follow-up": "node scripts/observe-defender-endpoint-follow-up.ts",
    "plan:avd-three-vm": "node scripts/plan-avd-three-vm-lab.ts",
    "package:calling-bot-app": "node scripts/package-teams-calling-bot-app.ts",
    "report:codex": "node scripts/codex-session-report.ts",
    "test:e2e:cba": "playwright test --config playwright.cba.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:artifact-hygiene && npm run check:workflow-security && npm run check:windows-host-boundary && npm run check:api-replicas && npm run check:api-container-provenance && vitest run",
    "test:container": "node scripts/test-api-container.ts",
    "test:api-lifecycle-container": "node scripts/test-api-lifecycle-container.ts",
    "test:api-security-headers-container": "node scripts/api-security-header-container-audit.ts",
    "test:api-backpressure-container": "node scripts/test-api-abuse-backpressure-container.ts",
    "test:shared-operation-journal-emulator": "node scripts/test-shared-operation-journal-emulator.ts",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/identity": "4.13.1",
    "@azure/msal-browser": "5.17.1",
    "@azure/msal-node": "5.4.2",
    "jose": "6.2.4",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.4",
    "jsdom": "29.1.1",
    "marked": "18.0.7",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
