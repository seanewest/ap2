{
  "name": "after-party",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "api": "node dist-api/index.js",
    "build:api": "vite build --config vite.api.config.ts",
    "calling-bot": "node dist-calling-bot/index.js",
    "build:calling-bot": "tsc -p tsconfig.calling-bot.json",
    "check:artifact-hygiene": "node scripts/check-repository-artifact-hygiene.ts",
    "check:api-container-provenance": "node scripts/api-container-provenance.ts",
    "check:workflow-security": "node scripts/check-github-actions-security.ts",
    "check:windows-host-boundary": "node scripts/check-windows-host-boundary.ts",
    "check:spa-bundle": "node scripts/check-spa-bundle-budget.ts",
    "check:api-routes": "node scripts/check-api-route-contracts.ts",
    "check:api-replicas": "node scripts/api-single-replica-contract.ts scripts/fixtures/api-single-replica-plan.json",
    "compile:api-deployment-artifact": "node scripts/api-container-app-deployment-artifact.ts",
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run check:spa-bundle && node scripts/build-docs.ts && npm run build:api && npm run build:calling-bot",
    "check:rehearsal-status": "node scripts/check-rehearsal-status.ts",
    "check:scenario-contracts": "node scripts/check-scenario-contract-compatibility.ts",
    "check:scenario-surfaces": "node scripts/check-scenario-surface-inventory.ts",
    "check:shared-device-readiness": "node scripts/shared-device-provisioning-readiness.ts",
    "preview:calendar-reset": "node scripts/preview-calendar-reset.ts",
    "preview:oauth-app-recon": "node scripts/preview-oauth-app-recon.ts",
    "observe:oauth-recon-signin": "node scripts/observe-oauth-recon-signin.ts",
    "plan:avd-three-vm": "node scripts/plan-avd-three-vm-lab.ts",
    "plan:multi-scenario-feasibility": "node scripts/plan-multi-scenario-feasibility.ts",
    "dry-run:avd-manifest-lifecycle": "node scripts/dry-run-avd-three-vm-manifest-cli.ts",
    "package:calling-bot-app": "node scripts/package-teams-calling-bot-app.ts",
    "plan:scenario": "node scripts/compile-scenario-plan.ts",
    "rehearse:avd-three-vm": "node scripts/run-avd-three-vm-rehearsal.ts",
    "rehearse:help-desk-email": "node scripts/run-help-desk-email-rehearsal.ts",
    "rehearse:oauth-app-recon": "node scripts/run-oauth-application-recon-rehearsal.ts",
    "rehearse:private-document": "node scripts/run-private-document-rehearsal.ts",
    "rehearse:purview-audit-boundary": "node scripts/run-purview-audit-boundary-rehearsal.ts",
    "rehearse:teams-missed-call": "node scripts/run-teams-missed-call-rehearsal.ts",
    "report:codex": "node scripts/codex-session-report.ts",
    "test:e2e:cba": "playwright test --config playwright.cba.config.ts",
    "test:e2e:local": "playwright test --config playwright.local.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "npm run check:artifact-hygiene && npm run check:workflow-security && npm run check:windows-host-boundary && npm run check:api-replicas && npm run check:api-container-provenance && vitest run",
    "test:container": "node scripts/test-api-container.ts",
    "test:api-lifecycle-container": "node scripts/test-api-lifecycle-container.ts",
    "test:api-security-headers-container": "node scripts/api-security-header-container-audit.ts",
    "test:api-backpressure-container": "node scripts/test-api-abuse-backpressure-container.ts",
    "test:rehearsal-verification-container": "node scripts/test-rehearsal-output-verification-container.ts",
    "test:private-document-rehearsal-container": "node scripts/test-private-document-rehearsal-verification-container.ts",
    "test:help-desk-email-rehearsal-container": "node scripts/test-help-desk-email-rehearsal-verification-container.ts",
    "test:oauth-app-recon-rehearsal-container": "node scripts/test-oauth-application-recon-rehearsal-verification-container.ts",
    "test:purview-audit-boundary-rehearsal-container": "node scripts/test-purview-audit-boundary-rehearsal-verification-container.ts",
    "test:teams-missed-call-rehearsal-container": "node scripts/test-teams-missed-call-rehearsal-verification-container.ts",
    "test:batch-feasibility-container": "node scripts/test-multi-scenario-feasibility-container.ts",
    "test:watch": "vitest",
    "validate:scenario-receipt": "node scripts/validate-scenario-evidence-receipt.ts",
    "verify:avd-three-vm-rehearsal": "node scripts/verify-avd-three-vm-rehearsal-output-cli.ts",
    "verify:help-desk-email-rehearsal": "node scripts/verify-help-desk-email-rehearsal-output-cli.ts",
    "verify:oauth-app-recon-rehearsal": "node scripts/verify-oauth-application-recon-rehearsal-output-cli.ts",
    "verify:purview-audit-boundary-rehearsal": "node scripts/verify-purview-audit-boundary-rehearsal-output-cli.ts",
    "verify:private-document-rehearsal": "node scripts/verify-private-document-rehearsal-output-cli.ts",
    "verify:teams-missed-call-rehearsal": "node scripts/verify-teams-missed-call-rehearsal-output-cli.ts"
  },
  "dependencies": {
    "@azure/identity": "4.13.1",
    "@azure/msal-browser": "5.17.1",
    "@azure/msal-node": "5.4.2",
    "jose": "6.2.4",
    "playwright": "1.61.1"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "24.10.4",
    "jsdom": "29.1.1",
    "marked": "18.0.7",
    "typescript": "7.0.2",
    "vite": "8.1.5",
    "vitest": "4.1.10"
  }
}
